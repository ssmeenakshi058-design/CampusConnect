{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "Core identity and role record for every authenticated CampusConnect user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "role": { "type": "string", "enum": ["student", "admin"] },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "displayName", "role", "accountStatus", "createdAt", "updatedAt"]
    },
    "StudentProfile": {
      "title": "StudentProfile",
      "description": "Private personal, academic, and professional profile for a registered college student.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "phone": { "type": "string", "maxLength": 24 },
        "college": { "type": "string", "maxLength": 160 },
        "course": { "type": "string", "maxLength": 120 },
        "specialization": { "type": "string", "maxLength": 120 },
        "graduationYear": { "type": "number" },
        "semester": { "type": "string", "maxLength": 40 },
        "academicYear": { "type": "string", "maxLength": 40 },
        "skills": { "type": "array", "description": "Up to 25 skill strings" },
        "interests": { "type": "array", "description": "Up to 15 interest strings" },
        "preferredIndustry": { "type": "string", "maxLength": 120 },
        "preferredLocation": { "type": "string", "maxLength": 120 },
        "preferredOpportunityType": { "type": "string", "maxLength": 60 },
        "resumeUrl": { "type": "string", "maxLength": 1000 },
        "resumeFileName": { "type": "string", "maxLength": 200 },
        "linkedInUrl": { "type": "string", "maxLength": 400 },
        "portfolioUrl": { "type": "string", "maxLength": 400 },
        "profileCompletion": { "type": "number" },
        "accountStatus": { "type": "string", "enum": ["active", "suspended"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "college", "course", "skills", "interests", "profileCompletion", "accountStatus", "createdAt", "updatedAt"]
    },
    "AdminProfile": {
      "title": "AdminProfile",
      "description": "Trusted administrator directory controlling access to the CampusConnect Admin Portal.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "fullName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "photoUrl": { "type": "string", "maxLength": 1000 },
        "title": { "type": "string", "maxLength": 100 },
        "department": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 24 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "fullName", "email", "title", "department", "createdAt", "updatedAt"]
    },
    "Company": {
      "title": "Company",
      "description": "Public company profile listed on CampusConnect; private contact details live in private subcollection.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "industry": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 2500 },
        "website": { "type": "string", "maxLength": 400 },
        "location": { "type": "string", "minLength": 1, "maxLength": 140 },
        "logoUrl": { "type": "string", "maxLength": 1000 },
        "verificationStatus": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "name", "industry", "description", "location", "verificationStatus", "createdBy", "createdAt", "updatedAt"]
    },
    "CompanyPrivateContact": {
      "title": "CompanyPrivateContact",
      "description": "Admin-only PII contact records for partner companies.",
      "type": "object",
      "properties": {
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "contactName": { "type": "string", "maxLength": 120 },
        "contactEmail": { "type": "string", "maxLength": 254 },
        "contactPhone": { "type": "string", "maxLength": 30 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["companyId", "contactName", "contactEmail", "updatedAt"]
    },
    "Opportunity": {
      "title": "Opportunity",
      "description": "Verified or pending internship, job, live project, or skill opportunity.",
      "type": "object",
      "properties": {
        "opportunityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "companyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "companyLogoUrl": { "type": "string", "maxLength": 1000 },
        "industry": { "type": "string", "minLength": 1, "maxLength": 100 },
        "category": { "type": "string", "enum": ["internship", "part_time", "entry_level", "live_project", "skill_building", "campus_event"] },
        "description": { "type": "string", "minLength": 10, "maxLength": 4000 },
        "responsibilities": { "type": "array", "description": "Up to 15 bullet strings" },
        "requiredSkills": { "type": "array", "description": "Up to 20 skill strings" },
        "eligibility": { "type": "string", "maxLength": 1000 },
        "educationQualification": { "type": "string", "maxLength": 200 },
        "workMode": { "type": "string", "enum": ["on_site", "remote", "hybrid"] },
        "location": { "type": "string", "minLength": 1, "maxLength": 140 },
        "isPaid": { "type": "boolean" },
        "stipendMin": { "type": "number" },
        "stipendMax": { "type": "number" },
        "stipendLabel": { "type": "string", "maxLength": 100 },
        "duration": { "type": "string", "maxLength": 100 },
        "openings": { "type": "number" },
        "deadline": { "type": "string", "maxLength": 30 },
        "requiredDocuments": { "type": "array", "description": "Up to 10 document strings" },
        "additionalQuestions": { "type": "array", "description": "Up to 5 screening question strings" },
        "allowReapply": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected", "expired", "closed"] },
        "isVerified": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["opportunityId", "title", "companyId", "companyName", "industry", "category", "description", "responsibilities", "requiredSkills", "eligibility", "educationQualification", "workMode", "location", "isPaid", "stipendMin", "stipendMax", "stipendLabel", "duration", "deadline", "requiredDocuments", "additionalQuestions", "allowReapply", "status", "isVerified", "createdBy", "createdAt", "updatedAt"]
    },
    "Application": {
      "title": "Application",
      "description": "Student application submitted to a specific verified opportunity.",
      "type": "object",
      "properties": {
        "applicationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "applicationCode": { "type": "string", "minLength": 4, "maxLength": 40 },
        "opportunityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opportunityTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "enum": ["internship", "part_time", "entry_level", "live_project", "skill_building", "campus_event"] },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "studentEmail": { "type": "string", "format": "email", "minLength": 3, "maxLength": 254 },
        "studentPhone": { "type": "string", "maxLength": 24 },
        "college": { "type": "string", "minLength": 1, "maxLength": 160 },
        "course": { "type": "string", "minLength": 1, "maxLength": 120 },
        "skills": { "type": "array", "description": "Up to 25 skills" },
        "resumeUrl": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "resumeFileName": { "type": "string", "maxLength": 200 },
        "coverLetter": { "type": "string", "maxLength": 3000 },
        "additionalAnswers": { "type": "array", "description": "Up to 5 answers" },
        "status": { "type": "string", "enum": ["submitted", "under_review", "shortlisted", "interview_scheduled", "selected", "rejected", "withdrawn"] },
        "adminNotes": { "type": "string", "maxLength": 1500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["applicationId", "applicationCode", "opportunityId", "opportunityTitle", "companyName", "category", "studentUid", "studentName", "studentEmail", "college", "course", "skills", "resumeUrl", "status", "createdAt", "updatedAt"]
    },
    "SavedOpportunity": {
      "title": "SavedOpportunity",
      "description": "Bookmarked opportunity saved by a student.",
      "type": "object",
      "properties": {
        "savedId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "studentUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opportunityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opportunityTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string", "maxLength": 60 },
        "location": { "type": "string", "maxLength": 140 },
        "deadline": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["savedId", "studentUid", "opportunityId", "opportunityTitle", "companyName", "category", "location", "deadline", "createdAt"]
    },
    "CampusEvent": {
      "title": "CampusEvent",
      "description": "Campus event, career workshop, placement prep, or skill session.",
      "type": "object",
      "properties": {
        "eventId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "eventType": { "type": "string", "enum": ["campus_event", "career_workshop", "placement_prep", "networking", "skill_session"] },
        "organizer": { "type": "string", "minLength": 1, "maxLength": 140 },
        "description": { "type": "string", "minLength": 10, "maxLength": 3000 },
        "venue": { "type": "string", "minLength": 1, "maxLength": 160 },
        "location": { "type": "string", "minLength": 1, "maxLength": 140 },
        "mode": { "type": "string", "enum": ["on_site", "online", "hybrid"] },
        "eventDate": { "type": "string", "maxLength": 30 },
        "eventTime": { "type": "string", "maxLength": 40 },
        "registrationDeadline": { "type": "string", "maxLength": 30 },
        "capacity": { "type": "number" },
        "registrationLink": { "type": "string", "maxLength": 400 },
        "bannerUrl": { "type": "string", "maxLength": 1000 },
        "status": { "type": "string", "enum": ["upcoming", "completed", "cancelled"] },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["eventId", "title", "eventType", "organizer", "description", "venue", "location", "mode", "eventDate", "eventTime", "registrationDeadline", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for a student or the admin operations queue.",
      "type": "object",
      "properties": {
        "notificationId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "recipientRole": { "type": "string", "enum": ["student", "admin"] },
        "type": { "type": "string", "minLength": 2, "maxLength": 60 },
        "title": { "type": "string", "minLength": 2, "maxLength": 180 },
        "message": { "type": "string", "minLength": 2, "maxLength": 600 },
        "relatedId": { "type": "string", "maxLength": 128 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["notificationId", "recipientUid", "recipientRole", "type", "title", "message", "isRead", "createdAt"]
    },
    "OpportunityReport": {
      "title": "OpportunityReport",
      "description": "Student-submitted safety report flagging a suspicious or misleading listing.",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opportunityId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "opportunityTitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "companyName": { "type": "string", "minLength": 1, "maxLength": 160 },
        "reportedByUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "reportedByName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "reason": { "type": "string", "enum": ["misleading_info", "unpaid_disguised", "fee_demanded", "fake_company", "expired_listing", "other"] },
        "details": { "type": "string", "minLength": 10, "maxLength": 1500 },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved", "dismissed"] },
        "adminActionNote": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reportId", "opportunityId", "opportunityTitle", "companyName", "reportedByUid", "reportedByName", "reason", "details", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{uid}": {
      "schema": { "$ref": "#/entities/UserAccount" },
      "description": "User authentication metadata and role assignment."
    },
    "/studentProfiles/{uid}": {
      "schema": { "$ref": "#/entities/StudentProfile" },
      "description": "Student personal, academic, and professional profiles."
    },
    "/adminProfiles/{uid}": {
      "schema": { "$ref": "#/entities/AdminProfile" },
      "description": "Authorized administrator directory."
    },
    "/companies/{companyId}": {
      "schema": { "$ref": "#/entities/Company" },
      "description": "Partner companies listed on CampusConnect."
    },
    "/companies/{companyId}/private/{docId}": {
      "schema": { "$ref": "#/entities/CompanyPrivateContact" },
      "description": "Admin-only contact PII for partner companies."
    },
    "/opportunities/{opportunityId}": {
      "schema": { "$ref": "#/entities/Opportunity" },
      "description": "Internships, part-time jobs, entry-level roles, live projects, and skill opportunities."
    },
    "/applications/{applicationId}": {
      "schema": { "$ref": "#/entities/Application" },
      "description": "Student applications linked to verified opportunities."
    },
    "/savedOpportunities/{savedId}": {
      "schema": { "$ref": "#/entities/SavedOpportunity" },
      "description": "Bookmarked opportunities saved per student UID."
    },
    "/events/{eventId}": {
      "schema": { "$ref": "#/entities/CampusEvent" },
      "description": "Campus events, workshops, and placement preparation sessions."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "In-app notifications for students and admins."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/OpportunityReport" },
      "description": "Safety reports filed by students against suspicious listings."
    }
  }
}
